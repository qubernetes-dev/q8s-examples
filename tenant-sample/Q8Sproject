name: sample-project

python_env:
  dependencies:
    - scikit-learn
    - mlflow
    - qiskit==1.2.4
    - pylatexenc

targets:
  gpu:
    python_env:
      dependencies:
        - qiskit-aer-gpu==0.15.1
  cpu:
    python_env:
      dependencies:
        - qiskit-aer==0.15.1

docker:
